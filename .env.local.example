# Site URL — used for canonical URLs and OG tags (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fungenevents.ca

# ─── Audit scripts (optional — only needed for `npm run pagespeed-audit` / `npm run gsc-audit`) ───

# PageSpeed Insights
PSI_URL=https://fungenevents.ca
PSI_API_KEY=
PSI_STRATEGY=both

# Google Search Console (see scripts/GSC_SETUP.md for full setup)
GSC_SITE_URL=https://fungenevents.ca/
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gsc-service-account.json

# ─── Contact form (Resend) — required for /api/contact to deliver enquiries ───
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiries are delivered (the studio inbox)
CONTACT_TO_EMAIL=fungeneventsinc@gmail.com
# The SENDER, and it must sit on a domain verified in Resend. This cannot be the
# gmail.com inbox above: Resend only sends from domains you can prove you own,
# and Gmail's own DMARC policy rejects mail that forges an @gmail.com sender.
# Verify fungenevents.ca in Resend and use an address on it, e.g.
#   "FunGen Events <enquiries@fungenevents.ca>"
CONTACT_FROM_EMAIL=
