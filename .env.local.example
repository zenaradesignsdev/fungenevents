# Site URL — used for canonical URLs and OG tags (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fungenevents.ca

# ─── Audit scripts (optional — only needed for `npm run pagespeed-audit` / `npm run gsc-audit`) ───

# PageSpeed Insights
PSI_URL=https://fungenevents.ca
PSI_API_KEY=
PSI_STRATEGY=both

# Google Search Console (see scripts/GSC_SETUP.md for full setup)
GSC_SITE_URL=https://fungenevents.ca/
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gsc-service-account.json

# ─── Re-add when the full site's contact form is built ───
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
